# =========================================================
# NUSA EAST — ENVIRONMENT VARIABLES
# Copy file ini menjadi ".env" lalu isi dengan value asli kamu.
# JANGAN commit file ".env" ke git.
# =========================================================

PORT=4000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/nusaeast

# --- Auth ---
JWT_SECRET=ganti_dengan_random_string_yang_panjang_dan_rahasia

# --- Payment Gateway: Midtrans (rekomendasi untuk pasar Indonesia) ---
# Daftar sandbox gratis di https://dashboard.midtrans.com/register
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Payment Gateway alternatif: Xendit ---
# XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxx

# --- Frontend URL (untuk redirect setelah pembayaran & CORS) ---
FRONTEND_URL=http://localhost:5500
